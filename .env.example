# PostgreSQL
POSTGRES_DB=stasiun_cuaca
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Laravel Backend
APP_NAME="WS Monitor"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_KEY=

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=stasiun_cuaca
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Ingestion config (AGENTS.md locked values)
OFFLINE_THRESHOLD_MINUTES=15
INGEST_MAX_BATCH=500
INGEST_CHUNK_SIZE=100
CLOCK_FUTURE_TOLERANCE_SEC=300
RAIN_MM_PER_TIP=0.2

# Frontend
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
