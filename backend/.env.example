APP_NAME="WS Monitor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=stasiun_cuaca
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Ingestion config (AGENTS.md locked values)
OFFLINE_THRESHOLD_MINUTES=15
INGEST_MAX_BATCH=500
INGEST_CHUNK_SIZE=100
CLOCK_FUTURE_TOLERANCE_SEC=300
RAIN_MM_PER_TIP=0.2
